<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="web_theme_obsidian.ColorSchemeToggle">
        <div class="o_ob_scheme_toggle d-flex align-items-center">
            <button type="button"
                    class="o_nav_entry o_ob_scheme_btn border-0"
                    t-att-class="{ 'is-dark': isDark }"
                    t-att-title="label"
                    t-att-aria-label="label"
                    t-att-aria-pressed="isDark ? 'true' : 'false'"
                    t-on-click="toggle">
                <!-- Sun: shown in dark mode (go light) -->
                <svg t-if="isDark" class="o_ob_scheme_icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="12" cy="12" r="4"/>
                    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
                </svg>
                <!-- Moon: shown in light mode (go dark) -->
                <svg t-else="" class="o_ob_scheme_icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>
                </svg>
            </button>
        </div>
    </t>
</templates>
