<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Tajawal for backend + login. System fonts take over if offline. -->
    <template id="layout_fonts" inherit_id="web.layout" name="Obsidian Fonts">
        <xpath expr="//head" position="inside">
            <link rel="preconnect" href="https://fonts.googleapis.com"/>
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin=""/>
            <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tajawal:wght@300;400;500;700;800;900&amp;display=swap"/>
        </xpath>
    </template>
</odoo>
